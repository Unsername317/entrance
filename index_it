        <div class="faq-q" onclick="this.classList.toggle('open')">
          <div class="q">印表機無法列印，出現離線狀態？<svg class="arw" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></div>
          <div class="a">請先檢查您的電腦是否成功連線至公司內部 Wi-Fi。若連線正常仍無法列印，請確認是否選錯印表機，或至 IT 報修系統建單。</div>
        </div>
        <div class="faq-q" onclick="this.classList.toggle('open')">
          <div class="q">遇到疑似釣魚信件該如何處理？<svg class="arw" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg></div>
          <div class="a">請絕對「不要」點擊信件內的任何連結或下載附件。請將該信件以「作為附件轉寄」的方式寄給資訊部信箱，並將原信件刪除。</div>
        </div>
      </div>
    </div>
  </section>

  <footer>
    總翔<span>企業</span> 資訊部入口網站 · 內部使用<br>
    遇到任何系統異常？<a class="feedback-link" href="mailto:it@anatekent.com?subject=IT入口網站-問題回報">點此聯絡資訊部</a>
  </footer>

  <button class="back-top" id="backTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="回到頂端">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="m18 15-6-6-6 6" />
    </svg>
  </button>

  <!-- ========== 彈跳視窗 ========== -->
  <div class="modal-mask" id="mask" onclick="if(event.target===this)closeModal()">
    <div class="modal">
      <div class="modal-head">
        <button class="modal-close" onclick="closeModal()">×</button>
        <div class="mtitle" id="mTitle"></div>
        <div class="mdate" id="mDate"></div>
      </div>
      <div class="modal-body" id="mBody"></div>
    </div>
  </div>

  <script>
    /* ===== IT 公告內容 ===== */
    const NEWS = [
      {
        title: "【資安宣導】近期偽造微軟信件增加，請防範釣魚郵件",
        date: "公告日 2026/08/10",
        body: `<p>各位同仁好：</p>
          <p>近日發現多起偽冒「Microsoft 帳號異常」、「密碼即將到期」的釣魚郵件。請同仁提高警覺，切勿點擊信件中的不明連結或輸入帳號密碼。</p>
          <p><b>防範三步驟：</b></p>
          <ul>
            <li>檢查寄件者網域是否為官方真實網域。</li>
            <li>不要輕易點擊信件內的超連結，可將滑鼠懸停查看實際網址。</li>
            <li>如有疑慮，請直接聯繫資訊部 (分機 7777)。</li>
          </ul>`
      },
      {
        title: "【系統維護】ERP 系統本週末 (8/15) 進行升級停機",
        date: "公告日 2026/08/05",
        body: `<p>為提升系統效能與穩定度，資訊部預計於以下時段進行 ERP 系統升級作業：</p>
        <p><b>停機時間：</b> 2026/08/15 (週六) 22:00 起至 2026/08/16 (週日) 04:00 止。</p>
        <p>影響範圍：</p>
        <ul>
          <li>ERP 企業資源規劃系統（全面暫停服務）</li>
          <li>BPM 電子簽核系統（與 ERP 相關之表單將無法拋轉）</li>
        </ul>
        <p>請有加班需求的同仁提前安排作業，造成不便敬請見諒。</p>`
      },
      { 
        title: "全公司防毒軟體升級作業已自動派送完成",
        date: "公告日 2026/07/28",
        body: `<p>全公司電腦防毒軟體已於本週透過 AD 背景自動派送更新至最新版本。</p>
        <p>若您的電腦右下角持續跳出「需要重新啟動以完成安裝」的提示，請您在下班前將電腦<b>重新開機</b>，以確保防護功能正常運作。</p>
        <p>若發現軟體無法開啟或電腦異常緩慢，請至 IT 報修系統填單。</p>` 
      }
    ];

    function openModal(i) {
      document.getElementById('mTitle').textContent = NEWS[i].title;
      document.getElementById('mDate').textContent = NEWS[i].date;
      document.getElementById('mBody').innerHTML = NEWS[i].body;
      document.getElementById('mask').classList.add('show');
    }
    function closeModal() { document.getElementById('mask').classList.remove('show') }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal() });

    /* ===== 導覽列點擊：手動計算捲動位置 ===== */
    const subnavEl = document.querySelector('.subnav');
    document.querySelectorAll('.subnav a').forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault();
        const target = document.querySelector(link.getAttribute('href'));
        if (!target) return;
        const navH = subnavEl.offsetHeight;
        const y = target.getBoundingClientRect().top + window.scrollY - navH - 8;
        window.scrollTo({ top: y, behavior: 'smooth' });
        history.replaceState(null, '', link.getAttribute('href'));
      });
    });

    /* ===== 進場淡入 ===== */
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target) } })
    }, { threshold: .12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    /* ===== 回到頂端按鈕顯示/隱藏 ===== */
    const backTop = document.getElementById('backTop');
    window.addEventListener('scroll', () => {
      backTop.classList.toggle('show', window.scrollY > 400);
    });

    /* ===== 導覽列高亮目前區塊 ===== */
    const navLinks = document.querySelectorAll('.subnav a');
    const secObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          navLinks.forEach(a => a.classList.remove('active'));
          const link = document.querySelector(`.subnav a[href="#${entry.target.id}"]`);
          if (link) link.classList.add('active');
        }
      });
    }, { rootMargin: '-30% 0px -60% 0px' });
    document.querySelectorAll('section[id]').forEach(sec => secObserver.observe(sec));
  </script>
</body>
</html>
